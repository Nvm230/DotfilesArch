{
    "layer": "top",
    "position": "left",
    "width": 50,
    //"height": 48,
    "spacing": 0,
    "margin": "0",
    "modules-left": [
        "custom/launcher",
        "custom/playerctl",
        "custom/cava"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "network",
        "battery",
        "clock",
        "custom/powermenu"
    ],
    // MODULE CONFIG
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ],
        "min-length": 7
    },
    "battery": {
        "rotate": 270,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": [
            " ",
            " ",
            " ",
            " ",
            " "
        ]
    },
    "clock": {
        "rotate": 0,
        "tooltip": false,
        "format": "{:%d\n%H\n%M}", // Salto de línea: Hora arriba, Minutos abajo
        "tooltip-format": "{:%d %B %Y}",
    },
    "clock#calendar": {
        "tooltip": false,
        "format": "{:%b %d}"
    },
    "network": {
        "tooltip": true,
        "interval": 30,
        "format": "",
        "format-wifi": " ",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format": "LINK: {ifname}\nIP: {ipaddr}/{cidr}\nSPEED: {bandwidthTotalBytes}",
        "on-click": "killall nmgui || nmgui"
    },
    "network#vpn": {
        "interface": "tun0",
        "format": ""
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": " {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                " ",
                " "
            ]
        },
        "scroll-step": 3,
        "on-scroll-up": "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 1%+",
        "on-scroll-down": "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 1%-",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "disable-scroll": false,
        "on-scroll-up": "$HOME/.config/hypr/scripts/next-workspace.sh",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "format": "{icon}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 10
        },
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": "󰧞",
            "sort-by-number": true
        },
    },
    // CUSTOM MODULES
    "custom/launcher": {
        "format": "._.",
        "on-click": "killall rofi || rofi -show",
        "tooltip": false
    },
    "custom/powermenu": {
        "format": " ",
        "on-click": "wlogout",
        "on-click-right": "wlogout",
        "tooltip": false
    },
    "custom/playerctl": {
        "format": "{icon}",
        "return-type": "json",
        "max-length": 64,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "on-click-middle": "playerctl play-pause",
        "on-click": "playerctl previous",
        "on-click-right": "playerctl next",
        "format-icons": {
            "Playing": "󰒮 󰐌 󰒭",
            "Paused": "󰒮 󰏥 󰒭"
        },
    },
}